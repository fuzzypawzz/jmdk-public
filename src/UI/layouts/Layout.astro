---
import '../assets/styles/index.css';
import '../assets/styles/css-reset.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Jannik Maag is a Senior Software Engineer and Front-End architect.
      He specialises in writing testable framework agnostic solutions at scale."
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inria+Sans:wght@300;700&family=Neucha&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" />
    <title>Jannik Maag</title>
  </head>
  <body>
    <script>
      import { useWindowHeightVariable } from '../assets/scripts/window-height-variable';
      useWindowHeightVariable();
    </script>
    <slot />
  </body>
</html>
