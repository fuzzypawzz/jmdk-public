---
import { layoutContent as content } from './layout.content';
import ThemeToggle from '../components/theme-toggle/ThemeToggle.astro';
import '../assets/styles/index.css';
import '../assets/styles/css-reset.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={content.metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/theme-toggles@4.10.1/css/expand.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inria+Sans:wght@300;700&family=Neucha&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" />
    <title>{content.siteTitle}</title>
  </head>
  <body>
    <script is:inline>
      (function () {
        const preferredTheme = localStorage.getItem('theme');

        if (preferredTheme === 'light' || preferredTheme === 'dark') {
          document.documentElement.setAttribute('data-theme', preferredTheme);
        }
      })();
    </script>

    <div class="app__wrapper">
      <header class="app__header no-select">
        <span>{content.header}</span>

        <ThemeToggle />
      </header>
      <slot />
    </div>
    <script>
      import { useWindowHeightVariable } from '../assets/scripts/window-height-variable';
      useWindowHeightVariable();
    </script>
  </body>
</html>
